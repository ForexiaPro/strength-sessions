    "test": "node --test \"test/*.test.js\"",
    "widgets": "node scripts/build-widgets.mjs",
    "strength": "node scripts/strength.mjs",
    "demo": "node scripts/strength.mjs --demo"
  },
  "engines": { "node": ">=18" },
  "keywords": ["forex", "currency strength meter", "forex sessions", "market hours", "session clock", "trading", "mt5"],
  "homepage": "https://github.com/ForexiaPro/strength-sessions",
